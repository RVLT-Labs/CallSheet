# Copy to .env and fill in real values for local dev.
# `docker compose up -d` starts a matching local Postgres if you keep the default DATABASE_URL below.

DATABASE_URL="postgresql://callsheet:callsheet@localhost:5432/callsheet?schema=public"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend (transactional email + calendar invites, spec §7)
RESEND_API_KEY=""
EMAIL_FROM="Callsheet <noreply@rvlt.app>"
