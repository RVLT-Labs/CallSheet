# Copy to .env and fill in real values for local dev.
# `docker compose up -d` starts a matching local Postgres if you keep the default DATABASE_URL below.

DATABASE_URL="postgresql://callsheet:callsheet@localhost:5432/callsheet?schema=public"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend (transactional email + calendar invites, spec §7)
RESEND_API_KEY=""
EMAIL_FROM="Callsheet <noreply@rvlt.app>"

# Guards the /api/cron/invite-reminders route Vercel Cron hits daily (vercel.json).
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Google Maps (shoot location autocomplete + map view). Needs the Places API and
# Maps JavaScript API enabled, with an HTTP-referrer-restricted browser key —
# this ships to the client, it is not a server secret. Without it, location
# editing falls back to a plain address text field and no map is shown.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
